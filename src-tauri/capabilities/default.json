{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Acesso mínimo ao editor e aos caminhos selecionados pelo usuário",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/**",
        "$APPCACHE/**"
      ]
    },
    "notification:default",
    "window-state:default"
  ]
}
